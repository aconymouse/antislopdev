{
  "name": "antislopdev",
  "version": "0.1.0",
  "description": "Rules and a checker that catch generic AI output in UI, copy, code, SEO and security.",
  "license": "MIT",
  "author": "Hafidz Nc",
  "homepage": "https://antislopdev.aconymous.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aconymouse/antislopdev.git"
  },
  "keywords": [
    "ai",
    "slop",
    "lint",
    "agent",
    "skill",
    "claude",
    "cursor",
    "design",
    "copywriting",
    "seo",
    "security",
    "linter"
  ],
  "type": "module",
  "bin": {
    "antislopdev": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "RULES.md",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "build": "node scripts/catalog.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p site/tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "site": "npm run build && node scripts/site.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.27.7",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.2",
    "react": "19.2",
    "react-dom": "19.2",
    "typescript": "^7.0.2"
  }
}
